{
  "$schema": "https://opencode.ai/config.json",

  // Сводки для компакции пишутся заранее и стоят токенов, даже если сессия
  // закончится раньше и сводка не понадобится. На бесплатных лимитах это
  // чистый перерасход, поэтому пишем сводку только когда она реально нужна.
  "compaction": {
    "auto": true,
    "background": false
  },

  // Сводки диалога — самая жирная скрытая статья расхода. Пишем их бесплатной
  // моделью, чтобы не жечь квоту основного провайдера. Если модель недоступна,
  // OpenCode сам откатится на модель сессии.
  "agents": {
    "compaction": { "model": "opencode/glm-5.3-flash-free" }
  }
}
